# ============================================================
# Mako v3.0 — Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- RPC ---
# Primary and fallback RPC endpoints. All RPC operations (balance, sends,
# confirmations, lookups) try primary first, then fall back automatically.
# Free tiers work but paid plans are more reliable for live trading.
# Recommended: Helius, QuickNode, Triton, Chainstack
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
FALLBACK_RPC_URL=

# --- Wallet ---
# USE A DEDICATED TRADING WALLET — never your main wallet!
# Base58-encoded private key. Leave empty for paper trading.
WALLET_PRIVATE_KEY=

# --- PumpPortal API ---
# Get your key at https://pumpportal.fun/trading-api/setup/
# Recommended: Lightning mode (server-side, no RPC needed for sends)
# With key: Lightning first, falls back to local RPC if Lightning fails
# Without key: local signing only, requires reliable RPC
PUMPPORTAL_API_KEY=

# --- Trading Mode ---
# "paper" = simulate trades with real data, "live" = real money
TRADING_MODE=paper
PAPER_BALANCE_SOL=2.0
PAPER_SLIPPAGE_PCT=3.0
NOTIFY_ONLY=false

# --- Strategy ---
# "sniper"       = buy new pump.fun tokens instantly
# "momentum"     = buy tokens with strong bonding curve growth
# "copy_trade"   = copy smart money wallets
# "graduation"   = buy tokens about to graduate to Raydium
# "multi"        = run all strategies simultaneously
STRATEGY=multi

# --- Position Sizing ---
MAX_BUY_SOL=0.05                # Max SOL per single buy (global cap)
MOMENTUM_MAX_BUY_SOL=0.03       # Max SOL per momentum trade
GRADUATION_MAX_BUY_SOL=0.04     # Max SOL per graduation trade
COPY_MAX_BUY_SOL=0.02           # Max SOL per copy trade
MAX_PORTFOLIO_SOL=1.0            # Max total SOL in open positions
MAX_CONCURRENT_POSITIONS=10      # Max tokens held at once
DAILY_LOSS_LIMIT_SOL=0.3         # Stop trading if daily loss exceeds this
MAX_DAILY_TRADES=20              # Max trades per day

# --- Sniper Settings ---
SNIPER_BUY_DELAY_SEC=2           # Wait N seconds after token creation
SNIPER_AUTO_SELL_SEC=30          # Auto-sell N seconds after buying
SNIPER_MIN_SOL_LIQUIDITY=5       # Min SOL in bonding curve
SNIPER_MIN_DEV_BUY_SOL=0.5      # Min developer initial buy
SNIPER_MAX_TOP_HOLDER_PCT=70     # Skip if top holder owns > X%

# --- Exit Timing ---
FAST_STOP_GRACE_SEC=180          # Seconds after buy before fast_stop_loss can trigger
NOSTOP_WINDOW_SEC=180            # Seconds after buy with widened stop-loss
NOSTOP_MULTIPLIER=4              # Stop-loss multiplier during no-stop window
WS_STOP_LOSS_ENABLED=false      # Allow WebSocket-triggered stop-losses (noisy)

# --- Exit Strategy ---
STOP_LOSS_PCT=10                 # Sell if down X%
MOMENTUM_STOP_LOSS_PCT=12        # Stop loss for momentum trades
TAKE_PROFIT_PCT=100              # Sell if up X% (first target)
TAKE_PROFIT_2_PCT=300            # Sell remaining if up X% (second target)
TRAILING_STOP_PCT=25             # Trailing stop: sell if drops X% from peak
PARTIAL_TAKE_PCT=50              # Sell X% of position at first TP
MAX_HOLD_MINUTES=30              # Force sell after X minutes
STALE_EXIT_MINUTES=10            # Exit if flat for X minutes
STALE_EXIT_PCT=7                 # "Flat" threshold (below X% gain)
GRADUATED_TRAILING_2_PCT=35      # Tighter trailing for graduated tokens

# --- Momentum Pipeline Filters ---
MIN_MOMENTUM_CONFIDENCE=0.65     # Min confidence score to buy (0.0-1.0)
MIN_MOMENTUM_SOL_IN_CURVE=15.0   # Min SOL in bonding curve
MIN_MOMENTUM_TXNS=30             # Min transaction count
MIN_MOMENTUM_CURVE_GROWTH=15.0   # Min bonding curve growth %
MIN_MOMENTUM_GROWTH_RATE=3.0     # Min growth rate %/min
MAX_CREATOR_TX_COUNT=80          # Skip if creator has > X past transactions
MIN_HOLDER_COUNT=5               # Min unique holders
PIPELINE_MAX_TOP_HOLDER_PCT=50   # Pipeline top holder filter

# --- Cooldowns ---
COOLDOWN_TRIGGER_LOSSES=5        # Enter cooldown after N consecutive losses
COOLDOWN_DURATION_SEC=120        # Cooldown duration in seconds
COOLDOWN_EXEMPT_CONFIDENCE=0.85  # Bypass cooldown if confidence > X

# --- Token Filters ---
MIN_LIQUIDITY_USD=5000           # Min liquidity to consider
MIN_TOKEN_AGE_SEC=5              # Min seconds old before buying
MAX_TOP_HOLDER_PCT=30            # Skip if top holder owns > X%
REQUIRE_SOCIAL=false             # Require twitter/telegram/website

# --- Copy Trading ---
# Comma-separated list of wallet addresses to copy
COPY_WALLETS=
COPY_DELAY_SEC=2                 # Delay before copying a trade

# --- Wallet Discovery ---
AUTO_DISCOVER_WALLETS=true       # Auto-discover profitable wallets
MAX_AUTO_WALLETS=10              # Max wallets to auto-track
MIN_WALLET_SCORE_TO_WATCH=50     # Min score to start tracking
WALLET_DISCOVERY_MIN_BUYS=2      # Min buys to evaluate a wallet
WALLET_DISCOVERY_MIN_SELLS=1     # Min sells to evaluate a wallet
WALLET_DISCOVERY_MIN_RATIO=1.15  # Min sell/buy SOL ratio (1.15 = 15% profit)

# --- Graduation ---
GRAD_MIN_CURVE_PCT=85            # Start tracking at this curve fill %
GRAD_BUY_AT_PCT=95               # Buy when curve hits this %

# --- Rug Detection ---
RUG_DETECTION=true               # Enable real-time rug detection
RUG_CREATOR_SELL_EXIT=true       # Exit if creator sells
RUG_CURVE_DROP_PCT=40            # Exit if curve drops > X%

# --- Re-entry Cooldown ---
MINT_COOLDOWN_MINUTES=30         # Don't re-buy a token for X minutes after selling

# --- Jupiter (for graduated tokens) ---
USE_JUPITER=true                 # Use Jupiter for post-graduation swaps
JUPITER_SLIPPAGE_BPS=1500        # Jupiter slippage in basis points

# --- Jito MEV Protection ---
USE_JITO=true                    # Send transactions via Jito bundles
JITO_TIP_SOL=0.001               # Jito tip per bundle

# --- Execution ---
SLIPPAGE_PCT=15                  # Slippage tolerance (%)
MOMENTUM_SLIPPAGE_PCT=12         # Slippage for momentum trades
PRIORITY_FEE_SOL=0.005           # Priority fee for transactions
POLL_INTERVAL_SEC=3              # Main loop interval in seconds

# --- Telegram (optional) ---
# Create a bot via @BotFather, send /start to get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
